# ==============================================================================
# KONFIGURASI DATABASE UTAMA: GOOGLE SPREADSHEET (SIM ASRAMA HAJI JAKARTA)
# ==============================================================================

# URL Web App Google Apps Script (.exec) yang telah dideploy (Akses: Anyone)
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbx.../exec
VITE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycbx.../exec

# ID Spreadsheet Google (ditemukan pada URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_ID=
VITE_GOOGLE_SHEETS_ID=

# Google Sheets API Key / Service Account (Opsional jika menggunakan Web App Apps Script)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Gemini API Key (Opsional)
GEMINI_API_KEY=
